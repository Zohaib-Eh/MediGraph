# LLM Provider for Relationship Classification
# Options: "ollama" (free, good for prototyping), "openai" (production), "anthropic"
LLM_PROVIDER=ollama

# Ollama Model for Classification (if using ollama)
# Options: "qwen2.5:7b" (best for structured output), "llama3.1:8b" (good reasoning), "llama3.2" (faster)
OLLAMA_MODEL=qwen2.5:7b

# OpenAI API Key (for production use)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here

# Anthropic API Key (alternative to OpenAI)
# Get from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Neo4j Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# OpenAI Model (if using OpenAI in production)
# Options: "gpt-4o-mini" (fast, cheap), "gpt-4o" (more accurate)
# OPENAI_MODEL=gpt-4o-mini
