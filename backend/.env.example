# Environment
ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=*
UPLOAD_MAX_SIZE_MB=10

# CSV Processing
CSV_CHUNK_WORKERS=4

# LLM Provider: used for query agent, relationship classification, and LLM extraction
# - "ollama": local models (default). Run: ollama serve, then ollama pull <model>
# - "gemini" / "openai" / "anthropic": API-based (set corresponding API key)
LLM_PROVIDER=ollama

# Ollama (when LLM_PROVIDER=ollama). Default model for query agent, relationship classification, etc. List: ollama list
OLLAMA_MODEL=llama3.2
# Optional: use a different model only for entity extraction from CSV descriptions (e.g. qwen2.5:7b)
# OLLAMA_MODEL_EXTRACTOR=qwen2.5:7b
# If API runs in Docker but Ollama is on your host:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Gemini (when LLM_PROVIDER=gemini). Free key: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-key
# GEMINI_MODEL=gemini-2.0-flash

# OpenAI (when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-key
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# Neo4j Database (use bolt:// for Neo4j 4+/5; ensure Neo4j is running or you'll get "Connection refused")
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

