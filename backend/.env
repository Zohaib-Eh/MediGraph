# Neo4j Configuration
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Server Configuration
PORT=8000
HOST=0.0.0.0

# LLM: Ollama only. Use the model you have; list with: ollama list
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
# Optional: use a different model only for entity extraction from descriptions (e.g. qwen2.5:7b)
# OLLAMA_MODEL_EXTRACTOR=qwen2.5:7b